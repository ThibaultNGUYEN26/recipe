DATABASE_URL="postgresql://user:password@localhost:5432/recipes"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string"
# Cross-origin production requests are detected automatically and upgraded to
# secure SameSite=None, partitioned cookies. These values remain the same-site
# defaults (recommended when using api.recipe.thibault-nguyen.dev).
COOKIE_SAME_SITE="lax"
COOKIE_PARTITIONED="false"
SESSION_TTL_DAYS=7
GOOGLE_CLIENT_ID="your-google-oauth-web-client-id.apps.googleusercontent.com"
PUBLIC_APP_URL="http://localhost:5173"
RESEND_API_KEY=""
EMAIL_FROM="Savor <noreply@your-domain.com>"

# Production monitoring. Create a Node.js project in Sentry and paste its DSN.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE=0.05
DB_LATENCY_WARNING_MS=1000
MEDIA_DISK_WARNING_PERCENT=80
MEDIA_DISK_CRITICAL_PERCENT=90

# Private media storage. Do not place this directory under a public/static root.
MEDIA_STORAGE_ROOT="./media-storage"
MEDIA_SIGNING_SECRET="change-me-to-a-separate-long-random-string"
MEDIA_QUARANTINE_RETENTION_HOURS=24

# Production moderation service. It must inspect all requested categories and
# return an explicit approved, review_required, or rejected decision.
MEDIA_MODERATION_ENDPOINT=""
MEDIA_MODERATION_API_KEY=""
MEDIA_MODERATION_TIMEOUT_MS=15000

# Development only. Omit in production. review_required is the safe default.
MEDIA_MODERATION_DEV_DECISION="review_required"
