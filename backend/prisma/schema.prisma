generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id      Int      @id @default(autoincrement())
  slug    String   @unique
  label   String
  recipes Recipe[]
}

model User {
  id                    Int                   @id @default(autoincrement())
  email                 String                @unique
  username              String?               @unique
  passwordHash          String?
  googleId              String?               @unique
  name                  String?
  preferredLanguage     String?
  emailVerifiedAt       DateTime?
  sessionVersion        Int                   @default(0)
  isAdmin               Boolean               @default(false)
  isVerified            Boolean               @default(false)
  isChefVerified        Boolean               @default(false)
  bio                   String?
  instagramUrl          String?
  tiktokUrl             String?
  youtubeUrl            String?
  avatarUrl             String?               @default("/api/media/default-avatar.svg")
  avatarMediaId         String?               @unique
  avatarMedia           MediaAsset?           @relation("ApprovedAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  pendingAvatarId       String?               @unique
  pendingAvatar         MediaAsset?           @relation("PendingAvatar", fields: [pendingAvatarId], references: [id], onDelete: SetNull)
  mediaAssets           MediaAsset[]          @relation("MediaOwner")
  createdAt             DateTime              @default(now())
  followers             Follow[]              @relation("Following")
  following             Follow[]              @relation("Follower")
  ratings               Rating[]
  savedRecipes          SavedRecipe[]
  savedCategories       SavedCategory[]
  recipes               Recipe[]
  recipeViews           RecipeView[]
  comments              Comment[]
  commentLikes          CommentLike[]
  recipeLikes           RecipeLike[]
  recipeMakes           RecipeMake[]
  notifications         Notification[]        @relation("NotificationRecipient")
  sentNotifications     Notification[]        @relation("NotificationActor")
  verifications         CreatorVerification[] @relation("VerificationApplicant")
  reviewedVerifications CreatorVerification[] @relation("VerificationReviewer")
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  reportsSubmitted       Report[]               @relation("ReportReporter")
  reportsReceived        Report[]               @relation("ReportedUser")
  blockedUsers           UserBlock[]            @relation("Blocker")
  blockedBy              UserBlock[]            @relation("Blocked")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationType {
  USER
  CHEF
}

model CreatorVerification {
  id               Int                @id @default(autoincrement())
  userId           Int
  user             User               @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  status           VerificationStatus @default(PENDING)
  type             VerificationType   @default(USER)
  socialLinks      Json
  message          String?
  verificationCode String
  rejectionReason  String?
  reviewedById     Int?
  reviewedBy       User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([reviewedById])
  @@unique([userId, type])
}

model Recipe {
  id            Int                 @id @default(autoincrement())
  slug          String              @unique
  originalLanguage String           @default("fr")
  originCountry String?             @db.Char(2)
  categoryId    Int
  category      Category            @relation(fields: [categoryId], references: [id])
  isPublic      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  translations  RecipeTranslation[]
  images        RecipeImage[]
  info          Json?
  tags          Json?
  videoUrl      String?
  sourcePlatform String?
  sourceUrl      String?
  sourceAuthor   String?
  sourceThumbnailUrl String?
  authorId      Int?
  author        User?               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ratings       Rating[]
  savedBy       SavedRecipe[]
  comments      Comment[]
  notifications Notification[]
  mediaAssets   MediaAsset[]
  views         RecipeView[]
  followSources Follow[]          @relation("FollowSourceRecipe")
  likes         RecipeLike[]
  makes         RecipeMake[]
  reports       Report[]

  @@index([originCountry])
}

model RecipeMake {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rating    Int?
  note      String?
  changes   String[] @default([])
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, recipeId])
  @@index([recipeId, createdAt])
}

model RecipeView {
  id        Int      @id @default(autoincrement())
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  viewerId  Int?
  viewer    User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  visitorId String?
  viewedAt  DateTime @default(now())

  @@index([recipeId, viewedAt])
  @@index([viewerId, viewedAt])
}

enum MediaKind {
  AVATAR
  RECIPE_IMAGE
  RECIPE_VIDEO
}

enum MediaStatus {
  UPLOADING
  PENDING
  APPROVED
  REVIEW_REQUIRED
  REJECTED
  FAILED
}

model MediaAsset {
  id                 String      @id @default(uuid())
  kind               MediaKind
  status             MediaStatus @default(UPLOADING)
  ownerId            Int
  owner              User        @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipeId           Int?
  recipe             Recipe?     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  quarantineKey      String?
  variants           Json?
  verifiedMime       String?
  sizeBytes          Int?
  width              Int?
  height             Int?
  durationSeconds    Float?
  moderationProvider String?
  moderationScores   Json?
  moderatedAt        DateTime?
  rejectionCategory  String?
  processingError    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  approvedAvatarFor  User?       @relation("ApprovedAvatar")
  pendingAvatarFor   User?       @relation("PendingAvatar")

  @@index([ownerId, status])
  @@index([recipeId, status])
  @@index([status, createdAt])
}

model RecipeTranslation {
  id           Int     @id @default(autoincrement())
  recipeId     Int
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  language     String
  title        String
  description  String?
  ingredients  Json
  instructions Json
  tips         Json?
  nutrition    Json?

  @@unique([recipeId, language])
}

model RecipeImage {
  id       Int     @id @default(autoincrement())
  recipeId Int
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  url      String
  isMain   Boolean @default(true)
  focalX   Float   @default(50)
  focalY   Float   @default(50)

  @@unique([recipeId, isMain])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId Int
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  sourceRecipeId Int?
  sourceRecipe   Recipe? @relation("FollowSourceRecipe", fields: [sourceRecipeId], references: [id], onDelete: SetNull)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([sourceRecipeId])
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  score     Float
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
}

model RecipeLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
}

model SavedRecipe {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId        Int
  recipe          Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  savedCategoryId Int?
  savedCategory   SavedCategory? @relation(fields: [savedCategoryId], references: [id], onDelete: SetNull)
  savedAt         DateTime       @default(now())

  @@unique([userId, recipeId])
  @@index([savedCategoryId])
}

model SavedCategory {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime      @default(now())
  recipes   SavedRecipe[]

  @@unique([userId, name])
}

model Comment {
  id        Int           @id @default(autoincrement())
  recipeId  Int
  recipe    Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  parentId  Int?
  parent    Comment?      @relation("Replies", fields: [parentId], references: [id])
  children  Comment[]     @relation("Replies")
  likes     CommentLike[]
  reports   Report[]
  createdAt DateTime      @default(now())
}

model CommentLike {
  id        Int     @id @default(autoincrement())
  commentId Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      String
  recipeId  Int?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum ReportTargetType {
  USER
  RECIPE
  COMMENT
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

model Report {
  id              Int              @id @default(autoincrement())
  reporterId      Int
  reporter        User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType      ReportTargetType
  targetUserId    Int?
  targetUser      User?            @relation("ReportedUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetRecipeId  Int?
  targetRecipe    Recipe?          @relation(fields: [targetRecipeId], references: [id], onDelete: Cascade)
  targetCommentId Int?
  targetComment   Comment?         @relation(fields: [targetCommentId], references: [id], onDelete: Cascade)
  reason          String
  notes           String?
  status          ReportStatus     @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetUserId])
  @@index([targetRecipeId])
  @@index([targetCommentId])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId Int
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
